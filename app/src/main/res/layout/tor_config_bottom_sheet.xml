<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bottom_sheet_rounded"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <View
            android:id="@+id/handle"
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:background="?attr/colorOutlineVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHeader"
            style="@style/BottomSheetHeader"
            android:layout_marginTop="24dp"
            android:text="Конфигурация Tor"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/handle" />

        <LinearLayout
            android:id="@+id/optionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/tvHeader">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swTorEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Включить Tor"
                android:layout_marginBottom="16dp" />

            <RadioGroup
                android:id="@+id/rgTorMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/rbDirect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Прямое подключение (Без мостов)" />

                <RadioButton
                    android:id="@+id/rbObfs4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Встроенные мосты (obfs4)" />

                <RadioButton
                    android:id="@+id/rbWebtunnel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Встроенные мосты (webtunnel)" />

                <RadioButton
                    android:id="@+id/rbDnstt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Встроенные мосты (dnstt)" />

                <RadioButton
                    android:id="@+id/rbCustom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Свои мосты" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/cbIgnoreEmptyUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Игнорировать мосты с пустым URL"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnBridges"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Ввод своих мостов"
                android:textAlignment="viewStart" />

            <Button
                android:id="@+id/btnProxy"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Настройка проксирования"
                android:textAlignment="viewStart" />

            <Button
                android:id="@+id/btnExitNode"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Выбор выходного узла"
                android:textAlignment="viewStart" />

        </LinearLayout>

        <Button
            android:id="@+id/btnClose"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Готово"
            app:layout_constraintTop_toBottomOf="@id/optionsContainer" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
