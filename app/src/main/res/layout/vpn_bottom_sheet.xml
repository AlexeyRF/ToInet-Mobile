<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bottom_sheet_rounded"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Настройки VPN"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swVpnEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Включить VPN туннелирование"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/llAppRouting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swAppRouting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Раздельное туннелирование (Proxifier rules)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenProxifierRules"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Настроить правила проксификации →" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VPN Провайдер:"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/rgVpnProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/rbByedpi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="38dp"
                android:paddingVertical="2dp"
                android:text="ByeDPI (порт 1080)" />

            <RadioButton
                android:id="@+id/rbEasyVpn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="38dp"
                android:paddingVertical="2dp"
                android:text="Easy-VPN" />

            <RadioButton
                android:id="@+id/rbOperaProxy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="38dp"
                android:paddingVertical="2dp"
                android:text="Opera Proxy" />

            <RadioButton
                android:id="@+id/rbTor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="38dp"
                android:paddingVertical="2dp"
                android:text="TOR (порт 5242)" />

            <RadioButton
                android:id="@+id/rbZapret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="38dp"
                android:paddingVertical="2dp"
                android:text="Zapret (порт 1081)" />

            <RadioButton
                android:id="@+id/rbRehab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="38dp"
                android:paddingVertical="2dp"
                android:text="Socks Rehab (порт 1788)" />

            <RadioButton
                android:id="@+id/rbTgws"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="38dp"
                android:paddingVertical="2dp"
                android:text="TGWS (порт 1480)" />

            <RadioButton
                android:id="@+id/rbFakeVpn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="38dp"
                android:paddingVertical="2dp"
                android:text="FakeVPN (Напрямую)" />

            <RadioButton
                android:id="@+id/rbSvpn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="38dp"
                android:paddingVertical="2dp"
                android:text="SVPN / SSH (порт 1770)" />
        </RadioGroup>

        <!--
        <LinearLayout
            android:id="@+id/llCustomVpnDns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">
            
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Произвольный DNS (оставьте пустым для стандарта)"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCustomVpnDns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        -->

        <LinearLayout
            android:id="@+id/llFakeVpnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FakeVPN Настройки"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swFakeTlsEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Режим FakeTLS (подмена SNI)"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFakeVpnDomains"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Домены (через пробел, например: web.max.ru sber.ru)"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFakeVpnDomains"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnApps"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Приложения для VPN" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Сохранить" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
