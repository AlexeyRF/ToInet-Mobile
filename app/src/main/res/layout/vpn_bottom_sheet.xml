<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bottom_sheet_rounded"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Настройки VPN"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swVpnEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Включить VPN туннелирование"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VPN Провайдер:"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgVpnProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbByedpi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ByeDPI (порт 1080)" />

            <RadioButton
                android:id="@+id/rbTor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOR (порт 5242)" />

            <RadioButton
                android:id="@+id/rbTgws"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TGWS (порт 1480)" />

            <RadioButton
                android:id="@+id/rbRehab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Socks Rehab (порт 1788)" />

            <RadioButton
                android:id="@+id/rbTurnProxy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="vk-turn" />
                
            <RadioButton
                android:id="@+id/rbFakeVpn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FakeVPN (Напрямую)" />
                
            <RadioButton
                android:id="@+id/rbOperaProxy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Opera Proxy" />
                
            <RadioButton
                android:id="@+id/rbCustom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Свой SOCKS5 провайдер" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/llCustomSocks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">
            
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="SOCKS IP"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCustomIp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>
            
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="SOCKS Port"
                android:layout_marginTop="8dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCustomPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnApps"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Приложения для VPN" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Сохранить" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
